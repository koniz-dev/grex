# Miscellaneous
*.class
*.log
# Acceptance-criteria evidence must be committable despite the *.log rule above.
# Invariant 4 of docs/issue-workflow.md requires evidence to be a retrievable
# file in the repository; without this negation the logs are silently dropped at
# `git add` time and an issue can be closed with no evidence behind it.
!docs/verification/**/*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
.kiro/
.agent/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment configuration files
# `.env` is intentionally NOT ignored: it is declared under `flutter: assets:`
# in pubspec.yaml, and a declared asset that does not exist fails the build
# before any Dart runs. It is committed empty so a fresh clone builds.
# After filling in your own values, run
#   git update-index --skip-worktree .env
# so your keys are never staged. See SETUP.md.
# `.env.example` is committed as the template of available settings.
.env.local
.env.*.local

# Firebase configuration files
# Note: According to Firebase docs, API keys are not secret but should have restrictions applied.
# .firebaserc and firebase.json are usually committed for team projects.
# Config files with API keys can be ignored for better security practice.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Android local configuration
android/local.properties
android/key.properties
android/app/upload-keystore.jks
android/app/upload-keystore.key

# Logs and reports
logs/