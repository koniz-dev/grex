# ============================================================================
# Environment Configuration Template
# ============================================================================
# The catalogue of every setting the app understands. Reference only — nothing
# here is read at runtime unless you copy it into `.env`.
#
# Your real settings go in `assets/env/env`, which is gitignored. Do not copy
# this whole file there: the empty `KEY=` lines below would override the
# environment-aware defaults in AppConfig. Copy only the settings you need.
#
# Usage:
#   # create assets/env/env and paste in the settings you need from this file
#
# Every key below can also be supplied with `--dart-define=KEY=value`, which
# takes effect when the key is absent or empty in `.env`. Only these keys work:
# EnvConfig resolves defines through a constant table, because a define is
# compile-time and a runtime key never resolves. Add a key here and to
# `_dartDefines` in lib/core/config/env_config.dart together -- a test fails if
# the two drift apart.
#
# See SETUP.md.
# ============================================================================

# ----------------------------------------------------------------------------
# Environment
# ----------------------------------------------------------------------------
# Options: development, staging, production
ENVIRONMENT=development

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------
# Base URL for API requests
# Examples:
#   Development: http://localhost:3000
#   Staging: https://api-staging.example.com
#   Production: https://api.example.com
BASE_URL=

# API Timeout Configuration (in seconds)
API_TIMEOUT=30
API_CONNECT_TIMEOUT=10
API_RECEIVE_TIMEOUT=30
API_SEND_TIMEOUT=30

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
# Enable/disable features (true/false, 1/0, yes/no, on/off)
# If not set, defaults are environment-aware:
#   - Logging: enabled in development/staging
#   - Analytics: enabled in staging/production
#   - Crash Reporting: enabled in staging/production
#   - Performance Monitoring: enabled in staging/production
#   - Debug Features: enabled in development only

ENABLE_LOGGING=
ENABLE_ANALYTICS=
ENABLE_CRASH_REPORTING=
ENABLE_PERFORMANCE_MONITORING=
ENABLE_DEBUG_FEATURES=
ENABLE_HTTP_LOGGING=

# ----------------------------------------------------------------------------
# App Information
# ----------------------------------------------------------------------------
APP_VERSION=0.0.1
APP_BUILD_NUMBER=1

# ----------------------------------------------------------------------------
# Supabase Configuration
# ----------------------------------------------------------------------------
# Get these values from your Supabase project dashboard
# Project Settings > API > Project URL and Project API keys

# Supabase Project URL (required)
# Example: https://your-project-id.supabase.co
SUPABASE_URL=

# Supabase Anonymous Key (required for client-side access)
# This is safe to use in client-side code
SUPABASE_ANON_KEY=

# Supabase Service Role Key — DO NOT FILL THIS IN
#
# This whole file is bundled as a Flutter asset (see pubspec.yaml), which means
# any value here ships inside the APK/IPA and is served at a public URL on web.
# The service-role key bypasses every RLS policy, so putting it here is
# equivalent to publishing full database access.
#
# Keep it in a server-only secret store (CI secrets, server env). If you run
# scripts/windows/database/utils/rotate-api-keys.ps1, it writes the rotated key
# into .env — clear it afterwards.
#
# Kept here only so tooling that greps for the name still finds it documented.
SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase Development (when using supabase start)
SUPABASE_LOCAL_URL=http://localhost:54321
SUPABASE_LOCAL_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ----------------------------------------------------------------------------
# Google Sign-In (native flow)
# ----------------------------------------------------------------------------
# Web client ID — used as serverClientId for the google_sign_in plugin so the
# returned idToken is issued for Supabase to validate. Same value goes into
# Supabase Dashboard → Authentication → Providers → Google.
#   Example: 1234567890-xxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=

# iOS client ID — required by google_sign_in on iOS/macOS so Google can
# verify the bundle ID. Leave empty on Android-only builds.
#   Example: 1234567890-yyyyyyyyyyyyyyyyyyyyy.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=

# ----------------------------------------------------------------------------
# Additional Configuration
# ----------------------------------------------------------------------------
# Add your custom environment variables here
# Example:
# API_KEY=your_api_key_here
# SENTRY_DSN=your_sentry_dsn_here
